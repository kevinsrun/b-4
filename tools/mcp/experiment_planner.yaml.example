# EXAMPLE ONLY -- not loaded by Omnigent. Run `python3 install.py` to generate
# Re-run that script after moving the repository or changing interpreter.
#
# Omnigent expands ${VAR} in `env` but NOT in `command` or `args` (its parser
# documents those as literals), so the paths below are resolved absolutes.

name: experiment_planner
transport: stdio
description: >-
  Deterministic experiment planner (active learning). Chooses the next
  computational experiment by expected information gain over the competing
  hypotheses, uncertainty, relevance and cost, and returns a ready-to-run
  ExperimentSpec. Plans only -- never runs or interprets anything.


command: "/absolute/path/to/python"
args:
  - "/absolute/path/to/repo/tools/launchers/planner.py"

env:
  PYTHONPATH: "/absolute/path/to/repo"
  # stdio is the MCP channel, so logs must stay off stdout.
  BACTERIOCIN_LOG_LEVEL: "WARNING"

# Only these tools reach the model.
tools:
  - plan_experiment
  - describe
  - get_schema

timeout: 60
