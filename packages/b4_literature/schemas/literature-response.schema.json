{
  "$defs": {
    "BacteriocinIdentity": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "sequence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        },
        "sequence_accession": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence Accession"
        }
      },
      "title": "BacteriocinIdentity",
      "type": "object"
    },
    "Contradiction": {
      "additionalProperties": false,
      "properties": {
        "contradiction_id": {
          "pattern": "^cx_[0-9a-f]{24}$",
          "title": "Contradiction Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Evidence Ids",
          "type": "array"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "unresolved": {
          "default": true,
          "title": "Unresolved",
          "type": "boolean"
        }
      },
      "required": [
        "contradiction_id",
        "evidence_ids",
        "topic",
        "description"
      ],
      "title": "Contradiction",
      "type": "object"
    },
    "EvidenceProvenance": {
      "additionalProperties": false,
      "properties": {
        "excerpt": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "extraction_method": {
          "enum": [
            "deterministic-rule",
            "curated",
            "model-assisted"
          ],
          "title": "Extraction Method",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "locator",
        "excerpt",
        "extraction_method"
      ],
      "title": "EvidenceProvenance",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "bacteriocin": {
          "$ref": "#/$defs/BacteriocinIdentity"
        },
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "conditions": {
          "$ref": "#/$defs/ExperimentalConditions"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_id": {
          "pattern": "^ev_[0-9a-f]{24}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_type": {
          "const": "literature-derived",
          "default": "literature-derived",
          "title": "Evidence Type",
          "type": "string"
        },
        "measurement": {
          "$ref": "#/$defs/Measurement"
        },
        "missing_variables": {
          "items": {
            "type": "string"
          },
          "title": "Missing Variables",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/EvidenceProvenance"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        },
        "target": {
          "$ref": "#/$defs/TargetIdentity"
        }
      },
      "required": [
        "evidence_id",
        "source",
        "bacteriocin",
        "target",
        "conditions",
        "measurement",
        "claim",
        "confidence",
        "missing_variables",
        "provenance"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "ExperimentalConditions": {
      "additionalProperties": false,
      "properties": {
        "assay_domain": {
          "default": "unknown",
          "enum": [
            "in_vitro",
            "in_vivo",
            "physiological_model",
            "unknown"
          ],
          "title": "Assay Domain",
          "type": "string"
        },
        "assay_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assay Type"
        },
        "bacteriocin_concentration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "growth_phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Growth Phase"
        },
        "incubation_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ionic_conditions": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/Quantity"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Ionic Conditions",
          "type": "object"
        },
        "medium": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medium"
        },
        "ph": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "producer_cell_density": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_cell_density": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "temperature_c": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ExperimentalConditions",
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "data_role": {
          "enum": [
            "measured",
            "author-interpretation"
          ],
          "title": "Data Role",
          "type": "string"
        },
        "original_text": {
          "minLength": 1,
          "title": "Original Text",
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "type",
        "original_text",
        "data_role"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "normalization_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalization Note"
        },
        "normalized_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Unit"
        },
        "normalized_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Value"
        },
        "original_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Unit"
        },
        "original_value": {
          "minLength": 1,
          "title": "Original Value",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "original_value"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "doi_or_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi Or Url"
        },
        "journal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Journal"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "default": "journal-article",
          "enum": [
            "journal-article",
            "preprint",
            "database-record",
            "other"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 2200,
              "minimum": 1800,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "required": [
        "source_id",
        "title"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "TargetIdentity": {
      "additionalProperties": false,
      "properties": {
        "organism": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organism"
        },
        "strain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strain"
        }
      },
      "title": "TargetIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "const": "literature-evidence-agent",
      "default": "literature-evidence-agent",
      "title": "Agent",
      "type": "string"
    },
    "artifacts": {
      "additionalProperties": true,
      "title": "Artifacts",
      "type": "object"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "contradictions": {
      "items": {
        "$ref": "#/$defs/Contradiction"
      },
      "title": "Contradictions",
      "type": "array"
    },
    "decision": {
      "additionalProperties": true,
      "title": "Decision",
      "type": "object"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Evidence",
      "type": "array"
    },
    "knowledge_gaps": {
      "items": {
        "type": "string"
      },
      "title": "Knowledge Gaps",
      "type": "array"
    },
    "query_id": {
      "title": "Query Id",
      "type": "string"
    },
    "recommended_next_action": {
      "additionalProperties": true,
      "title": "Recommended Next Action",
      "type": "object"
    },
    "recommended_searches": {
      "items": {
        "type": "string"
      },
      "title": "Recommended Searches",
      "type": "array"
    },
    "uncertainties": {
      "items": {
        "type": "string"
      },
      "title": "Uncertainties",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "query_id",
    "decision",
    "evidence",
    "knowledge_gaps",
    "contradictions",
    "recommended_searches",
    "confidence",
    "uncertainties",
    "artifacts",
    "warnings",
    "recommended_next_action"
  ],
  "title": "LiteratureResponse",
  "type": "object"
}
