# ==============================================================================
# NCBI E-Utilities and BLAST Configuration
# ==============================================================================
# Copy this file to .env and customize as needed.
# Do NOT commit secrets or API keys to version control.

# NCBI E-Utilities Credentials & Identification
# API key is optional. Without it, requests are limited to <= 3 req/sec.
# With an API key, E-utilities allow up to 10 req/sec.
# Note: NCBI BLAST URL API uses an independent queueing/compute model.
NCBI_API_KEY=
NCBI_EMAIL=user@example.com
NCBI_TOOL=b4-bacteriocin-lab
NCBI_TIMEOUT_SECONDS=15.0
NCBI_MAX_RETRIES=3

# NCBI BLAST Configuration
# Official BLAST URL API endpoint
BLAST_URL=https://blast.ncbi.nlm.nih.gov/Blast.cgi

# Timeouts & Polling
BLAST_TIMEOUT_SECONDS=60.0
BLAST_POLL_INTERVAL_SECONDS=5.0
BLAST_MAX_POLL_ATTEMPTS=30

# Concurrency & Safety Controls
# Prevent hackathon loops from spamming NCBI BLAST services
BLAST_MAX_CONCURRENT_REQUESTS=2
BLAST_CACHE_ENABLED=true
MAX_BLAST_QUERIES_PER_RUN=5

# Live Integration Testing
# Set to 1 to run the single live NCBI BLAST smoke test (requires network access)
RUN_LIVE_NCBI_BLAST_TESTS=0

# ==============================================================================
# Local Native BLAST+ Configuration
# ==============================================================================
# Backend selection: auto | local | remote
BLAST_BACKEND=auto
BLASTP_EXECUTABLE=blastp
MAKEBLASTDB_EXECUTABLE=makeblastdb
BLAST_LOCAL_DB_DIR=
BLAST_LOCAL_DEFAULT_DB=
BLAST_LOCAL_TIMEOUT_SECONDS=30.0
BLAST_LOCAL_NUM_THREADS=4

# Named local databases (prefixes or file paths)
BLAST_LOCAL_SWISSPROT_DB=
BLAST_LOCAL_REFSEQ_DB=
BLAST_LOCAL_BACTERIOCIN_DB=

# Live local BLAST testing (requires blastp and local database)
RUN_LOCAL_BLAST_TESTS=0
