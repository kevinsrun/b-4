{
  "$defs": {
    "RetrievalConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_results": {
          "default": 10,
          "maximum": 50,
          "minimum": 1,
          "title": "Max Results",
          "type": "integer"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "local",
                "live_ncbi",
                "hybrid"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "sources": {
          "items": {
            "enum": [
              "europe_pmc",
              "ncbi",
              "ncbi_pubmed",
              "ncbi_pmc"
            ],
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "timeout_seconds": {
          "default": 15.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "RetrievalConfig",
      "type": "object"
    },
    "SourceDocument": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "default": "abstract",
          "title": "Locator",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "source",
        "text"
      ],
      "title": "SourceDocument",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "doi_or_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi Or Url"
        },
        "journal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Journal"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "default": "journal-article",
          "enum": [
            "journal-article",
            "preprint",
            "database-record",
            "other"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 2200,
              "minimum": 1800,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "required": [
        "source_id",
        "title"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bacteriocin": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bacteriocin"
    },
    "conditions": {
      "additionalProperties": true,
      "title": "Conditions",
      "type": "object"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "mode": {
      "anyOf": [
        {
          "enum": [
            "local",
            "live_ncbi",
            "hybrid"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mode"
    },
    "query_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Query Id"
    },
    "question": {
      "maxLength": 2000,
      "minLength": 3,
      "title": "Question",
      "type": "string"
    },
    "retrieval": {
      "$ref": "#/$defs/RetrievalConfig"
    },
    "source_documents": {
      "items": {
        "$ref": "#/$defs/SourceDocument"
      },
      "maxItems": 100,
      "title": "Source Documents",
      "type": "array"
    },
    "target_organism": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Organism"
    },
    "target_strain": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Strain"
    }
  },
  "required": [
    "question"
  ],
  "title": "LiteratureQuery",
  "type": "object"
}
